# ==============================================================================
# Application & Environment Settings
# ==============================================================================
# Set ENVIRONMENT to 'development' for local development or 'production' for live deployments.
# In 'production', the application validates that insecure dev secrets are NOT used.
PROJECT_NAME=Online Cinema
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Security & JWT Tokens
# WARNING: In production, generate a strong random 32+ char secret!
SECRET_KEY=insecure-dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# API Documentation Access (HTTP Basic Auth for /docs, /redoc, /openapi.json)
# ==============================================================================
DOCS_USERNAME=admin
DOCS_PASSWORD=cinema_admin

# ==============================================================================
# Database (PostgreSQL)
# ==============================================================================
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=cinema_password
POSTGRES_DB=cinema_db

# ==============================================================================
# Caching & Background Task Broker (Redis & Celery)
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ==============================================================================
# Object Storage (MinIO / S3)
# ==============================================================================
# For production S3, set MINIO_ENDPOINT to your S3 host and MINIO_SECURE=True.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=cinema-avatars
MINIO_SECURE=False

# ==============================================================================
# Email Delivery (Mailpit for local dev, real SMTP for production)
# ==============================================================================
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=False
EMAILS_FROM_EMAIL=noreply@onlinecinema.local
EMAILS_FROM_NAME=Online Cinema

# ==============================================================================
# Stripe Payment Integration
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_dummy_key
STRIPE_WEBHOOK_SECRET=whsec_dummy_key